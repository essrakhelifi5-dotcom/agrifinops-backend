generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")




}

//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String

  oauthToken OAuthToken?
}

//////////////////////////////////////////////////////
// OAUTH TOKEN
//////////////////////////////////////////////////////

model OAuthToken {
  id           String   @id @default(uuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  realmId      String 

  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////
// INVOICE
//////////////////////////////////////////////////////

model Invoice {
  id          String   @id @default(uuid())
  docNumber   String
  issueDate   DateTime
  dueDate     DateTime
  totalAmount Decimal   @db.Decimal(12,2)
  balance     Decimal   @db.Decimal(12,2)
  status      String

  payments Payment[]
}

//////////////////////////////////////////////////////
// PAYMENT
//////////////////////////////////////////////////////

model Payment {
  id          String   @id @default(uuid())
  paymentDate DateTime
  amount      Decimal  @db.Decimal(12,2)
  method      String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

//////////////////////////////////////////////////////
// EXPENSE
//////////////////////////////////////////////////////

model Expense {
  id          String   @id @default(uuid())
  expenseDate DateTime
  amount      Decimal  @db.Decimal(12,2)
  description String

  transactionLines TransactionLine[]
}

//////////////////////////////////////////////////////
// TRANSACTION LINE
//////////////////////////////////////////////////////

model TransactionLine {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(12,2)
  rawCategory String

  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

//////////////////////////////////////////////////////
// CATEGORY
//////////////////////////////////////////////////////

model Category {
  id   String @id @default(uuid())
  name String

  transactionLines TransactionLine[]
}